# Copy to .env and edit. All settings are optional; defaults suit local use.

# --- server ---
SCAMSHIELD_HOST=127.0.0.1
SCAMSHIELD_PORT=8000
# Comma-separated. Loopback only by default - nothing should leave the machine.
SCAMSHIELD_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- paths ---
# SCAMSHIELD_DATA_DIR=./data
# SCAMSHIELD_MODELS_DIR=./models

# --- scoring ---
# Override the threshold learned during training (normally leave unset).
# SCAMSHIELD_THRESHOLD_OVERRIDE=0.30
# Messages shorter than this with no red flags are capped - "Hi" proves nothing.
# SCAMSHIELD_LOW_INFO_TOKENS=4
# SCAMSHIELD_LOW_INFO_CAP=0.25
# SCAMSHIELD_MIN_CATEGORY_CONFIDENCE=0.25

# --- limits ---
# SCAMSHIELD_MAX_UPLOAD_BYTES=8388608
# SCAMSHIELD_MAX_BATCH_MESSAGES=500

# --- URL inspection sandbox ---
# Offline link analysis is always on and needs nothing here.
# This switch controls the *fetching* inspector, which makes a real outbound
# request. That tells whoever controls the link that your number is live and
# reveals your IP, so it is off unless you deliberately turn it on.
SCAMSHIELD_SANDBOX_ENABLED=false
# SCAMSHIELD_SANDBOX_TIMEOUT_SECONDS=8
# SCAMSHIELD_SANDBOX_MAX_REDIRECTS=5
# SCAMSHIELD_SANDBOX_MAX_BYTES=512000
# Test-only. Disables the SSRF address filter - never set this where
# untrusted URLs are accepted.
# SCAMSHIELD_SANDBOX_ALLOW_PRIVATE_HOSTS=false

# --- WhatsApp Business Platform (Cloud API) ---
# Off by default: with this unset no public webhook endpoint is mounted.
SCAMSHIELD_WA_ENABLED=false
# From Meta App Dashboard -> WhatsApp -> Configuration.
# The verify token is a string you choose and paste into the dashboard.
SCAMSHIELD_WA_VERIFY_TOKEN=
# App secret: Settings -> Basic. Used to check X-Hub-Signature-256 on every
# delivery. Without it the webhook refuses to run at all.
SCAMSHIELD_WA_APP_SECRET=
# Permanent access token for the system user that owns the number.
SCAMSHIELD_WA_ACCESS_TOKEN=
SCAMSHIELD_WA_PHONE_NUMBER_ID=
# SCAMSHIELD_WA_API_VERSION=v21.0

# Replying sends a message from your business number. Off until you opt in.
SCAMSHIELD_WA_AUTO_REPLY=false
# Risk at or above which a warning goes out. Unset = the model's own
# high-confidence threshold.
# SCAMSHIELD_WA_ALERT_THRESHOLD=0.85
# Minimum seconds between warnings to one contact.
SCAMSHIELD_WA_ALERT_COOLDOWN_SECONDS=3600
# SCAMSHIELD_WA_HISTORY_LIMIT=100
# SCAMSHIELD_WA_MARK_READ=false

# --- logging ---
SCAMSHIELD_LOG_LEVEL=INFO
SCAMSHIELD_LOG_JSON=false
